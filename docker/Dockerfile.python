# ============================================================
# PaperFactory Python Service
# 多阶段构建: 依赖安装 → 测试 → 生产镜像
# ============================================================

# --- 阶段1: 依赖安装 ---
FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim AS base
WORKDIR /app
COPY pyproject.toml uv.lock ./

# --- 阶段2: 开发环境 (含测试工具) ---
FROM base AS dev
RUN uv sync --group dev
COPY packages/ packages/
COPY apps/ apps/
COPY tests/ tests/
ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["uv", "run", "pytest", "tests/", "-v"]

# --- 阶段3: 测试环境 ---
FROM base AS test
RUN uv sync --group dev && uv pip install pytest-cov
COPY packages/ packages/
COPY apps/ apps/
COPY tests/ tests/
ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["uv", "run", "pytest", "tests/", "--cov=packages", "--cov-report=term-missing", "--cov-report=xml"]

# --- 阶段4: 生产环境 (最小镜像) ---
FROM python:3.11-slim AS prod
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY --from=base /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

COPY pyproject.toml ./
COPY packages/ packages/
COPY apps/ apps/

EXPOSE 8000
USER nobody
CMD ["uvicorn", "apps.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
